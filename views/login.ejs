<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Entrar · HelpDesk TI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="bg-glow" aria-hidden="true"></div>
  <main class="auth-page">
    <section class="card auth-card">
      <div class="auth-brand">
        <span class="brand-logo"><%- icon('zap', 20) %></span>
        <span class="brand-text">HelpDesk<strong>TI</strong></span>
      </div>
      <h1 class="auth-title">Acesse o sistema de chamados</h1>
      <p class="auth-sub">Entre com e-mail e senha, crie uma conta ou use o Google.</p>

      <% if (!firebaseConfigurado) { %>
        <div class="alert alert-error auth-msg" role="alert"><%- icon('alert') %><div>Firebase ainda não configurado. Cole o <code>firebaseConfig</code> em <code>config/firebaseClient.js</code>.</div></div>
      <% } %>
      <div class="alert alert-error auth-msg" role="alert" id="auth-erro" hidden><%- icon('alert') %><div id="auth-erro-texto"></div></div>

      <form id="form-login" novalidate>
        <div class="field">
          <label for="nome">Nome <span class="auth-hint">(necessário só para criar conta)</span></label>
          <input type="text" id="nome" autocomplete="name" placeholder="Seu nome completo" maxlength="100">
        </div>
        <div class="field">
          <label for="email">E-mail</label>
          <input type="email" id="email" autocomplete="email" placeholder="voce@empresa.com" required>
        </div>
        <div class="field">
          <label for="senha">Senha</label>
          <input type="password" id="senha" autocomplete="current-password" placeholder="Mínimo de 6 caracteres" required>
        </div>
        <div class="auth-actions">
          <button type="submit" class="btn btn-primary" id="btn-entrar"><%- icon('lock', 16) %> Entrar</button>
          <button type="button" class="btn btn-secondary" id="btn-criar"><%- icon('plus', 16) %> Criar conta</button>
        </div>
      </form>

      <div class="auth-divider">ou</div>

      <button type="button" class="btn btn-google btn-block" id="btn-google">
        <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
        Entrar com Google
      </button>
    </section>
  </main>

  <script type="application/json" id="firebase-config"><%- JSON.stringify(firebaseConfig).replace(/</g, '\\u003c') %></script>
  <script type="module" src="/js/login.js" data-saiu="<%= saiu ? '1' : '' %>" data-ok="<%= firebaseConfigurado ? '1' : '' %>"></script>
</body>
</html>
